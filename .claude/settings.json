{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-config.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-edit.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-tests.sh",
            "timeout": 120,
            "statusMessage": "Running tests\u2026"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/mobile-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest -q)",
      "Bash(.venv/bin/python -m pytest -q tests/*)",
      "Bash(.venv/bin/python tools/mobile_check.py)",
      "Bash(.venv/bin/ruff check training_coach tests tools)",
      "Bash(curl -s localhost:*)",
      "Bash(.venv/bin/python tools/mobile_check.py *)",
      "Bash(.venv/bin/python tools/mobile_check.py:*)",
      "Bash(.venv/bin/python -m pytest -q tests)",
      "Bash(.venv/bin/python dev/smoke.py)",
      "Bash(.venv/bin/python dev/smoke.py *)",
      "Bash(dev/devha.sh up)",
      "Bash(dev/devha.sh rebuild)",
      "Bash(dev/devha.sh logs *)",
      "Bash(dev/devha.sh health)",
      "Bash(TC_DATA_DIR=/tmp/tc-demo .venv/bin/python tools/seed_demo.py)",
      "Bash(.venv/bin/ruff check *)",
      "Bash(pkill -f \"uvicorn app.main:app\")",
      "Bash(uv pip install --python .venv/bin/python *)"
    ]
  }
}
