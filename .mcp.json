{
  "mcpServers": {
    "home-assistant": {
      "type": "http",
      "url": "${HA_URL:-http://192.168.68.156:8123}/api/mcp",
      "headers": {
        "Authorization": "Bearer ${HA_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chrome"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    }
  }
}
